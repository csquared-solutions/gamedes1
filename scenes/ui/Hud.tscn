[node name="Keys" type="Label" parent="StartOverlay/Card/CardContent/Rules"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.902, 0.639, 1)
theme_override_font_sizes/font_size = 16
text = "GOAL\nARROWS / WASD\nWICK\nE\nF\nOIL FLASK\nCRAWLER\nMOTH\nLEVEL 3+\nDANGER\nR  /  P"
horizontal_alignment = 2

[node name="Meanings" type="Label" parent="StartOverlay/Card/CardContent/Rules"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.88, 0.72, 1)
theme_override_font_sizes/font_size = 16
text = "Find the stair and step onto it before your wick runs out.\nMove one tile. Every action burns 1 wick.\nYour light and your clock. Less wick, smaller light.\nSet the lamp down. Its light stays there; walk back over it to take it.\nFlare: costs 3 wick and doubles your light for one turn.\nStep on it: 2 turns of darkness, then +6 wick.\nFast in the dark, slow inside your light.\nWakes when SIGHT is 5 or more, then flies at your lamp.\nSet the lamp down before you step onto the stair.\nA crawler or moth that reaches your lamp smothers the light.\nRestart the level  /  practice mode (wick frozen, Z to undo)."

[node name="ContentNote" type="Label" parent="StartOverlay/Card/CardContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.7, 0.64, 1)
text = "CONTENT NOTE: sustained darkness and insects"
horizontal_alignment = 1

[node name="StartPrompt" type="Label" parent="StartOverlay/Card/CardContent"]
